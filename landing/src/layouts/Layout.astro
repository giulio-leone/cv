---
import '../styles/global.css'
import CustomCursor from '../components/CustomCursor'
import AuroraBackground from '../components/AuroraBackground'

interface Props { title?: string }
const { title = 'Giulio Leone — Senior AI Engineer' } = Astro.props
const base = import.meta.env.BASE_URL
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Senior AI Engineer specializing in RAG, Agentic AI, and LLM Systems. 7+ years, 66+ certifications. Open to UAE." />
  <meta property="og:title" content="Giulio Leone — Senior AI Engineer" />
  <meta property="og:description" content="RAG · Agentic AI · LLM Systems · 66+ Certifications · Open to UAE" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://giulio-leone.github.io/cv/" />
  
  {/* Premium SVG Favicon instead of emoji */}
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23050a14'/><path d='M30 70L50 30L70 70' stroke='%23ffffff' stroke-width='8' fill='none' stroke-linejoin='round'/><circle cx='50' cy='60' r='6' fill='%23ffffff'/></svg>" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="overflow-x-hidden relative bg-background">
  {/* Base global animated aurora layer */}
  <AuroraBackground client:load />

  {/* Global grain texture for premium analog feel */}
  <div class="noise-bg pointer-events-none" aria-hidden="true"></div>
  
  {/* Custom fluid cursor */}
  <CustomCursor client:load />
  
  <slot />
</body>
</html>
