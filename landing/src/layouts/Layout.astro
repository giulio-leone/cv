---
import '../styles/global.css'
import CustomCursor from '../components/CustomCursor'
import AuroraBackground from '../components/AuroraBackground'

interface Props { title?: string }
const { title = 'Giulio Leone — Senior AI Engineer' } = Astro.props
const base = import.meta.env.BASE_URL
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Senior AI Engineer specializing in RAG, Agentic AI, and LLM Systems. 7+ years, 66+ certifications. Open to UAE." />
  <meta property="og:title" content="Giulio Leone — Senior AI Engineer" />
  <meta property="og:description" content="RAG · Agentic AI · LLM Systems · 66+ Certifications · Open to UAE" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://giulio-leone.github.io/cv/" />
  
  {/* Premium SVG Favicon instead of emoji */}
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23050a14'/><path d='M30 70L50 30L70 70' stroke='%23ffffff' stroke-width='8' fill='none' stroke-linejoin='round'/><circle cx='50' cy='60' r='6' fill='%23ffffff'/></svg>" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet" />
</head>
<body class="overflow-x-hidden relative bg-background">
  {/* Global Preloader for true Awwwards feel - Vanilla JS to avoid React Hydration FOUC */}
  <div id="global-preloader" class="fixed inset-0 z-[99999] bg-background flex flex-col items-center justify-center transition-transform duration-[1.2s] ease-[cubic-bezier(0.76,0,0.24,1)]">
    <div class="overflow-hidden">
      <div id="preloader-counter" class="text-6xl md:text-8xl font-light text-foreground translate-y-[100%] transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)]" style="font-family: 'Playfair Display', serif;">000</div>
    </div>
  </div>

  {/* Base global animated aurora layer */}
  <AuroraBackground client:load />

  {/* Global grain texture for premium analog feel */}
  <div class="noise-bg pointer-events-none" aria-hidden="true"></div>
  
  {/* Custom fluid cursor */}
  <CustomCursor client:load />
  
  <slot />

  <script>
    import Lenis from 'lenis';

    // Lenis Setup
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // easeOutExpo
      orientation: 'vertical',
      gestureOrientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 1,
      touchMultiplier: 2,
      infinite: false,
    });

    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }

    requestAnimationFrame(raf);

    // Preloader Logic
    document.addEventListener("DOMContentLoaded", () => {
      const preloader = document.getElementById('global-preloader');
      const counter = document.getElementById('preloader-counter');
      if (!preloader || !counter) return;

      let progress = 0;
      
      // Initial Reveal of counter
      setTimeout(() => {
        counter.style.transform = 'translateY(0)';
      }, 50);

      // We want to count exactly from 000 to 100
      const updateCounter = () => {
        counter.innerText = progress.toString().padStart(3, '0');
      };

      const interval = setInterval(() => {
        progress += Math.floor(Math.random() * 4) + 1; // slow increment for effect
        if (progress >= 100) {
          progress = 100;
          clearInterval(interval);
          updateCounter();
          
          // Slide counter down
          setTimeout(() => {
            counter.style.transform = 'translateY(100%)';
            // Slide preloader up
            setTimeout(() => {
              preloader.style.transform = 'translateY(-100%)';
              // Dispatch event to start hero animations
              (window as any).preloaderDone = true;
              window.dispatchEvent(new CustomEvent('preloaderComplete'));
            }, 600);
          }, 400);
        } else {
          updateCounter();
        }
      }, 20); 
    });
  </script>
</body>
</html>
