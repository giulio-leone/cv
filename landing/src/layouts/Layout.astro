---
import '../styles/global.css'
import CustomCursor from '../components/CustomCursor'
import ParticleNetwork from '../components/ParticleNetwork'
import ThemeToggle from '../components/ThemeToggle'
import content from '../data/content.json'

interface Props { title?: string }
const { title = content.meta.siteTitle } = Astro.props
---
<!DOCTYPE html>
<html lang="en" data-theme="dark" data-theme-mode="auto">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>
    (() => {
      const storageKey = 'cv-theme-mode';
      const hasStorage = typeof window !== 'undefined' && 'localStorage' in window;

      const resolveTheme = (mode) => {
        if (mode === 'light' || mode === 'dark') return mode;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      try {
        const storedMode = hasStorage ? window.localStorage.getItem(storageKey) : null;
        const mode = storedMode === 'light' || storedMode === 'dark' || storedMode === 'auto'
          ? storedMode
          : 'auto';

        document.documentElement.dataset.themeMode = mode;
        document.documentElement.dataset.theme = resolveTheme(mode);
      } catch {
        document.documentElement.dataset.themeMode = 'auto';
        document.documentElement.dataset.theme = resolveTheme('auto');
      }
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={content.meta.siteDescription} />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f7fb" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#05070d" />
  <meta property="og:title" content={content.meta.ogTitle} />
  <meta property="og:description" content={content.meta.ogDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://giulio-leone.github.io/cv/" />
  
  {/* Premium SVG Favicon instead of emoji */}
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23050a14'/><path d='M30 70L50 30L70 70' stroke='%23ffffff' stroke-width='8' fill='none' stroke-linejoin='round'/><circle cx='50' cy='60' r='6' fill='%23ffffff'/></svg>" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://github.com" />
  <link rel="dns-prefetch" href="//github.com" />
  <link rel="preconnect" href="https://raw.githubusercontent.com" />
  <link rel="dns-prefetch" href="//raw.githubusercontent.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet" />
</head>
<body class="overflow-hidden relative bg-background text-text-primary h-[100dvh] w-full">
  {/* Global Preloader for true Awwwards feel - Vanilla JS to avoid React Hydration FOUC */}
  <div id="global-preloader" class="fixed inset-0 z-[99999] bg-background flex flex-col items-center justify-center transition-transform duration-[1.2s] ease-[cubic-bezier(0.76,0,0.24,1)]">
    <div class="overflow-hidden">
      <div id="preloader-counter" class="text-6xl md:text-8xl font-light text-foreground translate-y-[100%] transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)]" style="font-family: 'Playfair Display', serif;">000</div>
    </div>
  </div>

  {/* Custom fluid cursor */}
  <CustomCursor client:load />
  <ParticleNetwork client:load />
  <ThemeToggle client:load />
  
  <slot />

  <script>
    // Preloader Logic
    document.addEventListener("DOMContentLoaded", () => {
      const preloader = document.getElementById('global-preloader');
      const counter = document.getElementById('preloader-counter');
      if (!preloader || !counter) return;

      let progress = 0;
      let revealTimeout = 0;
      let counterSlideTimeout = 0;
      let preloaderSlideTimeout = 0;
      let interval = 0;

      const cleanup = () => {
        clearInterval(interval);
        clearTimeout(revealTimeout);
        clearTimeout(counterSlideTimeout);
        clearTimeout(preloaderSlideTimeout);
      };

      window.addEventListener('pagehide', cleanup, { once: true });

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (prefersReducedMotion) {
        counter.innerText = '100';
        preloader.style.transform = 'translateY(-100%)';
        window.preloaderDone = true;
        window.dispatchEvent(new CustomEvent('preloaderComplete'));
        cleanup();
        return;
      }
      
      // Initial Reveal of counter
      revealTimeout = window.setTimeout(() => {
        counter.style.transform = 'translateY(0)';
      }, 50);

      // We want to count exactly from 000 to 100
      const updateCounter = () => {
        counter.innerText = progress.toString().padStart(3, '0');
      };

      interval = window.setInterval(() => {
        progress += Math.floor(Math.random() * 4) + 1; // slow increment for effect
        if (progress >= 100) {
          progress = 100;
          clearInterval(interval);
          updateCounter();
          
          // Slide counter down
          counterSlideTimeout = window.setTimeout(() => {
            counter.style.transform = 'translateY(100%)';
            // Slide preloader up
            preloaderSlideTimeout = window.setTimeout(() => {
              preloader.style.transform = 'translateY(-100%)';
              // Dispatch event to start hero animations
              window.preloaderDone = true;
              window.dispatchEvent(new CustomEvent('preloaderComplete'));
              cleanup();
            }, 600);
          }, 400);
        } else {
          updateCounter();
        }
      }, 20); 
    });
  </script>
</body>
</html>
